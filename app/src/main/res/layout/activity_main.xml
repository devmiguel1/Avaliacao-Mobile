<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Componente customizado -->
    <com.example.avaliacaomobile.WaterProgressView
        android:id="@+id/waterView"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        app:maxValue="2000"
        app:progressColor="#2196F3"
        app:textColor="#000000" />

    <TextView
        android:id="@+id/tvAccumulated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Alerta de meta ultrapassada (só aparece quando acumulado > meta) -->
    <TextView
        android:id="@+id/tvAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFEBEE"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#D32F2F"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Meta diária -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etGoal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_goal"
            android:inputType="number"
            android:maxLength="5"
            android:textColor="#212121"
            android:textColorHint="#757575" />

        <Button
            android:id="@+id/btnGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_set_goal" />
    </LinearLayout>

    <!-- Registrar consumo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_volume"
            android:inputType="number"
            android:maxLength="4"
            android:textColor="#212121"
            android:textColorHint="#757575" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_register" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/title_today_records"
        android:textColor="#212121"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listRecords"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>